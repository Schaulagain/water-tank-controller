# The address you open the page on. Over Tailscale that's something like http://homelab:8000
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kathmandu

# Change the secret to anything long and random.
REVERB_APP_KEY=water-key
REVERB_APP_SECRET=change-me
REVERB_PUBLIC_PORT=6001

MQTT_TOPIC=home/water

# How much faster than real life the simulator moves water. Set SIMULATOR_ENABLED=false
# and stop the simulator container once the real board is in.
SIM_SPEED=10
SIMULATOR_ENABLED=true

# Pick a long random topic name and subscribe to it in the ntfy iPhone app.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
